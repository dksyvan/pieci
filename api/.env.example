DATABASE_URL=postgres://pieci:pieci@localhost:5432/pieci
# Mettre à "true" pour les bases hébergées qui exigent SSL (ex. Supabase).
DB_SSL=false
PORT=3000

# Origines autorisées en CORS, séparées par des virgules. Laisser vide en
# développement pour tout autoriser. En production, y mettre TOUS les domaines
# du frontend — un domaine oublié se traduit par « Une erreur est survenue »
# côté utilisateur, sans indice sur la cause.
FRONTEND_URL=

# Supabase Storage (photos des pièces trouvées)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# Notifications push web (VAPID). Générer la paire avec :
#   npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:contact@pieci.ci
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── SMS ───────────────────────────────────────────────────────────────────
# Canal payant, sollicité UNIQUEMENT si aucune notification gratuite n'a pu
# joindre la personne. C'est le seul canal qui atteigne les utilisateurs
# d'iPhone n'ayant pas installé la PWA.
#
# Tant que SMS_ACTIF n'est pas "true", rien n'est envoyé et rien n'est
# facturé. Le format ci-dessous suit Twilio ; pour un agrégateur local, seule
# la méthode `appelerFournisseur` de CanalSms change.
SMS_ACTIF=false
SMS_COMPTE=
SMS_JETON=
SMS_EXPEDITEUR=
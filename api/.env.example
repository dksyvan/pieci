DATABASE_URL=postgres://pieci:pieci@localhost:5432/pieci
# Mettre à "true" pour les bases hébergées qui exigent SSL (ex. Supabase).
DB_SSL=false
PORT=3000

# Origine autorisée en CORS (URL du frontend en prod). Laisser vide en dev
# pour autoriser toutes les origines.
FRONTEND_URL=

# Supabase Storage (photos des pièces trouvées)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

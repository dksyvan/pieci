{
  "expo": {
    "name": "Pièci",
    "slug": "pieci",
    "scheme": "pieci",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#B03A22",
    "backgroundColor": "#F4F2EC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dibyyvan.pieci",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dibyyvan.pieci",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#F4F2EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2EC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pièci accède à tes photos pour joindre l'image d'une pièce trouvée.",
          "cameraPermission": "Pièci utilise l'appareil photo pour prendre en photo la pièce trouvée.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pièci utilise ta position pour retrouver ta commune automatiquement.",
          "locationWhenInUsePermission": "Pièci utilise ta position pour retrouver ta commune automatiquement.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B03A22"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5385277c-4458-458d-93ce-94c6bd34b409"
      }
    },
    "owner": "dksyvan"
  }
}
